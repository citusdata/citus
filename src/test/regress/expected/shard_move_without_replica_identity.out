JOIN pg_dist_shard_placement p USING (shardid)
JOIN pg_dist_node n
  ON n.nodename = p.nodename AND n.nodeport = p.nodeport
WHERE s.shardid = :shardid_cleanup_dependency \gset
\c - - - :src_cleanup_dependency
