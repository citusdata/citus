\c - - - :master_port
-- Test 9: The promotion cannot run inside a transaction block, where its write
-- fence would last until the transaction ends, and a rollback could not undo
-- pg_promote(), so the clone stays a replica
BEGIN;
SELECT citus_promote_clone_and_rebalance(clone_nodeid => :clone_node_id);
ERROR:  citus_promote_clone_and_rebalance cannot run inside a transaction block
DETAIL:  Its write fence would last until the transaction ends, and a rollback could not undo the promotion of the clone.
HINT:  Run the promotion outside a transaction block, for example with autocommit enabled.
ROLLBACK;
-- Verify no data is lost
SELECT COUNT(*) from backup_test;
 count
