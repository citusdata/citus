(1 row)

-- The live remote-EXPLAIN path must still use the current ExplainState.
SELECT bool_and(options = (:'options_off'::jsonb || '{"verbose":true}'))
    AS non_analyze_options
FROM worker_options($$
    EXPLAIN (VERBOSE, COSTS OFF, FORMAT JSON) EXECUTE ps(0)
$$) AS worker(options);
 non_analyze_options
---------------------------------------------------------------------
 t
(1 row)

\set VERBOSITY terse
EXPLAIN (ANALYZE, unknown_option) EXECUTE ps(0);
ERROR:  unrecognized EXPLAIN option "unknown_option" at character 19
EXPLAIN (TIMING ON) EXECUTE ps(0);
ERROR:  EXPLAIN option TIMING requires ANALYZE
SELECT bool_and(options = :'options_off'::jsonb) AS options_after_error
FROM worker_options($$
    EXPLAIN (ANALYZE, VERBOSE OFF, COSTS OFF, BUFFERS OFF, WAL OFF,
             TIMING OFF, SUMMARY OFF, MEMORY OFF, SERIALIZE OFF, FORMAT JSON)
    EXECUTE ps(0)
$$) AS worker(options);
 options_after_error
---------------------------------------------------------------------
 t
(1 row)

DEALLOCATE ps;
DEALLOCATE router;
DEALLOCATE update_ps;
RESET search_path;
DROP SCHEMA explain_execute CASCADE;
RESET citus.explain_all_tasks;
RESET citus.shard_count;
RESET client_min_messages;
