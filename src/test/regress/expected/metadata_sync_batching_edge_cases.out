DROP TABLE msbe_mixed.extension_owned_table;
-- DROP SCHEMA ... CASCADE fails with "cache lookup failed for type" when a table
-- is distributed on a type from the same schema, because the sql_drop trigger
-- rebuilds the table's cache entry after the type is gone. This also happens on
-- main without any metadata sync, so drop the table first. This is a known issue,
-- see https://github.com/citusdata/citus/issues/6392.
DROP TABLE msbe_mixed.enum_table, msbe_mixed.quoted_enum_table;
DROP SCHEMA msbe_mixed, "msbe_mixed Quoted!", "msbe_mixed Tenant Quoted!" CASCADE;
RESET client_min_messages;
--
-- Section 5: values outside of the allowed ranges, and who can set them.
--
-- citus.metadata_sync_cache_flush_interval must be between 0 and INT_MAX.
SET citus.metadata_sync_cache_flush_interval TO -1;
ERROR:  -1 is outside the valid range for parameter "citus.metadata_sync_cache_flush_interval" (0 .. 2147483647)
SET citus.metadata_sync_cache_flush_interval TO 0;
RESET citus.metadata_sync_cache_flush_interval;
-- citus.metadata_sync_set_batch_size must be between 1 and 10000.
SET citus.metadata_sync_set_batch_size TO 0;
ERROR:  0 is outside the valid range for parameter "citus.metadata_sync_set_batch_size" (1 .. 10000)
SET citus.metadata_sync_set_batch_size TO 10001;
ERROR:  10001 is outside the valid range for parameter "citus.metadata_sync_set_batch_size" (1 .. 10000)
SET citus.metadata_sync_set_batch_size TO 1;
SET citus.metadata_sync_set_batch_size TO 10000;
RESET citus.metadata_sync_set_batch_size;
-- Any user can set citus.metadata_sync_cache_flush_interval, but only a
-- superuser can set citus.metadata_sync_set_batch_size.
CREATE ROLE metadata_sync_non_superuser;
SET ROLE metadata_sync_non_superuser;
SET citus.metadata_sync_cache_flush_interval TO 1;
SET citus.metadata_sync_set_batch_size TO 1;
ERROR:  permission denied to set parameter "citus.metadata_sync_set_batch_size"
RESET ROLE;
RESET citus.metadata_sync_cache_flush_interval;
DROP ROLE metadata_sync_non_superuser;
--
-- Section 6: metadata sync logs a DEBUG1 message when it starts and when it
-- finishes each of its phases.
--
-- We hide the notices that the workers send back (e.g. "schema ... already
-- exists, skipping"), because they depend on which objects the earlier tests
-- left behind.
--
SELECT citus_remove_node('localhost', :worker_2_port);
 citus_remove_node
---------------------------------------------------------------------

(1 row)

