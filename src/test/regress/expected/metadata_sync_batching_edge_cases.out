ALTER SEQUENCE pg_catalog.pg_dist_node_nodeid_seq RESTART :last_node_id;
SET citus.worker_min_messages TO WARNING;
SET client_min_messages TO DEBUG1;
SELECT 1 FROM citus_add_node('localhost', :worker_2_port);
