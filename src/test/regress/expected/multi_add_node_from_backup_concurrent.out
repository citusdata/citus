--
-- Test that citus_promote_clone_and_rebalance() blocks the changes that the
-- clone could miss once it stops replicating: writes to the primary's shards
-- from any node, DDL from any node, commit decisions of distributed
-- transactions that the primary starts, shard moves, splits and rebalances
-- that involve the primary, changes to the colocation groups with shards on
-- the primary, and new shards. Also test that it does not start while a shard
-- move onto the primary runs, or while the primary has prepared transactions
-- that are not resolved yet, that the promotion of another clone waits for it
-- rather than deadlocking with it, that the clone gets its own group id only
-- once transaction recovery on it ends, that a recovery run that starts on the
-- clone meanwhile waits for it, that the clone deletes the cleanup records that
-- it copied before that, and that shard ids that do not fit in an int are kept
-- intact. Registering the clone in a transaction that wrote to the primary
-- keeps that write.
--
-- Pausing the replay on the clone keeps the promotion waiting for the clone to
-- catch up, with all of these blocked. The promotion runs over dblink, so this
-- session must stay connected to the coordinator until it finishes.
--
CREATE SCHEMA promotion_concurrency;
SET search_path TO promotion_concurrency;
SET citus.next_shard_id TO 9960000;
SET citus.shard_count TO 32;
SET citus.shard_replication_factor TO 1;
SET statement_timeout TO '120s';
-- tables without shards on the primary, created before it joins the cluster
CREATE TABLE moved (id int PRIMARY KEY);
SELECT create_distributed_table('moved', 'id', shard_count => 1, colocate_with => 'none');
 create_distributed_table
---------------------------------------------------------------------

(1 row)

CREATE TABLE inflight (id int PRIMARY KEY);
SELECT create_distributed_table('inflight', 'id', shard_count => 1, colocate_with => 'none');
 create_distributed_table
---------------------------------------------------------------------

(1 row)

CREATE TABLE spread (id int PRIMARY KEY);
SELECT create_distributed_table('spread', 'id', shard_count => 16, colocate_with => 'none');
 create_distributed_table
---------------------------------------------------------------------

(1 row)

SELECT shardid AS moved_shard_id, nodeport AS moved_shard_port
FROM pg_dist_shard_placement JOIN pg_dist_shard USING (shardid)
WHERE logicalrelid = 'moved'::regclass \gset
SELECT nodeid AS moved_node_id FROM pg_dist_node WHERE nodeport = :moved_shard_port \gset
SELECT CASE WHEN :moved_shard_port = :worker_1_port THEN :worker_2_port ELSE :worker_1_port END AS moved_target_port \gset
SELECT shardid AS inflight_shard_id, nodeport AS inflight_shard_port
FROM pg_dist_shard_placement JOIN pg_dist_shard USING (shardid)
WHERE logicalrelid = 'inflight'::regclass \gset
-- DDL from workers is propagated only if the coordinator is in the metadata
SET client_min_messages TO WARNING;
SELECT 1 FROM citus_set_coordinator_host('localhost', :master_port);
 ?column?
---------------------------------------------------------------------
        1
(1 row)

SELECT master_add_node('localhost', :worker_5_port) AS worker_5_node_id \gset
RESET client_min_messages;
-- the tables with shards on the primary get shard ids that do not fit in an int
RESET citus.next_shard_id;
ALTER SEQUENCE pg_catalog.pg_dist_shardid_seq RESTART 3000000000;
CREATE TABLE dist (id int PRIMARY KEY);
SELECT create_distributed_table('dist', 'id');
 create_distributed_table
---------------------------------------------------------------------

(1 row)

INSERT INTO dist SELECT generate_series(1, 100);
CREATE TABLE late (id int PRIMARY KEY);
CREATE TABLE new_dist (id int PRIMARY KEY);
CREATE TABLE cdtc (id int PRIMARY KEY);
SELECT citus_add_local_table_to_metadata('cdtc');
 citus_add_local_table_to_metadata
---------------------------------------------------------------------

(1 row)

-- keys in a shard on the primary and in shards on two other workers
WITH placed_keys AS (
    SELECT g AS id, nodeport
    FROM generate_series(101, 2000) g
    JOIN pg_dist_shard_placement p
      ON p.shardid = get_shard_id_for_distribution_column('dist', g)
)
SELECT (SELECT min(id) FROM placed_keys WHERE nodeport = :worker_5_port) AS key_on_primary,
       (SELECT max(id) FROM placed_keys WHERE nodeport = :worker_5_port) AS other_key_on_primary,
       (SELECT min(id) FROM placed_keys WHERE nodeport = :worker_1_port) AS key_on_worker_1,
       (SELECT max(id) FROM placed_keys WHERE nodeport = :worker_1_port) AS other_key_on_worker_1,
       (SELECT min(id) FROM placed_keys WHERE nodeport = :worker_2_port) AS key_on_worker_2 \gset
SET citus.enable_ddl_propagation TO off;
CREATE EXTENSION dblink;
RESET citus.enable_ddl_propagation;
SELECT format('host=localhost port=%s dbname=%s user=%s', :master_port, current_database(), current_user) AS coordinator_conn,
       format('host=localhost port=%s dbname=%s user=%s', :worker_5_port, current_database(), current_user) AS primary_conn,
       format('host=localhost port=%s dbname=%s user=%s', :follower_worker_5_port, current_database(), current_user) AS clone_conn,
       format('host=localhost port=%s dbname=%s user=%s', :worker_1_port, current_database(), current_user) AS worker_1_conn \gset
SELECT set_config('promotion_concurrency.primary_conn', :'primary_conn', false) IS NOT NULL AS set,
       set_config('promotion_concurrency.clone_conn', :'clone_conn', false) IS NOT NULL AS set,
       set_config('promotion_concurrency.worker_1_conn', :'worker_1_conn', false) IS NOT NULL AS set;
 set | set | set
---------------------------------------------------------------------
 t   | t   | t
(1 row)

-- registering the clone keeps the changes that its transaction made on the
-- primary
BEGIN;
INSERT INTO dist VALUES (:other_key_on_primary);
SELECT citus_add_clone_node('localhost', :follower_worker_5_port, 'localhost', :worker_5_port) AS clone_node_id \gset
NOTICE:  checking replication relationship between primary localhost:xxxxx and clone localhost:xxxxx
NOTICE:  checking replication status of clone node localhost:xxxxx
NOTICE:  clone localhost:xxxxx is properly connected to primary localhost:xxxxx and is not synchronous
COMMIT;
SELECT count(*) AS committed FROM dist WHERE id = :other_key_on_primary;
 committed
