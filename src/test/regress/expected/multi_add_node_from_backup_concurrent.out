-- before the promotion waits for recovery to assign the group id, the clone
-- deletes the cleanup records that it copied, so that its maintenance daemon
-- does not act on them meanwhile
DO $$
BEGIN
    WHILE NOT EXISTS (
        SELECT FROM dblink(current_setting('promotion_concurrency.clone_conn'),
                           $q$SELECT 1 FROM pg_stat_activity a JOIN pg_locks l ON l.pid = a.pid
                              WHERE a.query = 'SELECT pg_catalog.recover_prepared_transactions()'
                                AND l.locktype = 'advisory'$q$) AS t(found int))
      AND (SELECT groupid FROM dblink(current_setting('promotion_concurrency.clone_conn'),
                                      'SELECT groupid FROM pg_dist_local_group') AS t(groupid int))
          = current_setting('promotion_concurrency.primary_group_id')::int LOOP
        PERFORM pg_sleep(0.01);
    END LOOP;
END $$;
SELECT c AS clone_cleanup_records
FROM dblink(:'clone_conn', 'SELECT count(*) FROM pg_dist_cleanup') AS t(c bigint);
 clone_cleanup_records
---------------------------------------------------------------------
                     0
(1 row)

-- a recovery run that starts on the clone meanwhile waits for the transaction
-- recovery lock, which the promotion keeps until the clone has its own group
-- id, since the run reads the group id only once it has the lock
SELECT dblink_connect('late_recovery', :'clone_conn' || ' application_name=late_recovery');
 dblink_connect
---------------------------------------------------------------------
 OK
(1 row)

SELECT dblink_send_query('late_recovery', 'SELECT pg_catalog.recover_prepared_transactions()');
 dblink_send_query
---------------------------------------------------------------------
                 1
(1 row)

DO $$
BEGIN
    WHILE dblink_is_busy('late_recovery') = 1 AND NOT EXISTS (
        SELECT FROM dblink(current_setting('promotion_concurrency.clone_conn'),
                           $q$SELECT 1 FROM pg_stat_activity a JOIN pg_locks l ON l.pid = a.pid
                              WHERE a.application_name = 'late_recovery'
                                AND l.locktype = 'advisory' AND NOT l.granted$q$) AS t(found int)) LOOP
        PERFORM pg_sleep(0.01);
    END LOOP;
END $$;
SELECT dblink_is_busy('late_recovery') AS late_recovery_waits;
 late_recovery_waits
---------------------------------------------------------------------
                   1
(1 row)

-- once commits on worker_1 do not wait anymore, recovery on the clone ends, the
-- promotion finishes, and then the other one
SELECT dblink_exec(:'worker_1_conn', 'ALTER SYSTEM RESET synchronous_standby_names');
 dblink_exec
---------------------------------------------------------------------
 ALTER SYSTEM
(1 row)

SELECT r AS reloaded FROM dblink(:'worker_1_conn', 'SELECT pg_catalog.pg_reload_conf()') AS t(r bool);
 reloaded
---------------------------------------------------------------------
 t
(1 row)

SELECT count(*) AS probe_committed FROM dblink_get_result('sync_probe') AS t(x bigint);
 probe_committed
---------------------------------------------------------------------
               1
(1 row)

SELECT dblink_disconnect('sync_probe');
 dblink_disconnect
---------------------------------------------------------------------
 OK
(1 row)

SELECT r AS promoted FROM dblink_get_result('promotion') AS t(r text);
 promoted
---------------------------------------------------------------------

(1 row)

SELECT dblink_disconnect('promotion');
 dblink_disconnect
---------------------------------------------------------------------
 OK
(1 row)

SELECT r AS late_recovery_recovered FROM dblink_get_result('late_recovery') AS t(r int);
 late_recovery_recovered
---------------------------------------------------------------------
                       0
(1 row)

SELECT dblink_disconnect('late_recovery');
 dblink_disconnect
---------------------------------------------------------------------
 OK
(1 row)

SELECT r AS other_promoted FROM dblink_get_result('other_promotion') AS t(r text);
 other_promoted
---------------------------------------------------------------------

(1 row)

SELECT dblink_disconnect('other_promotion');
 dblink_disconnect
---------------------------------------------------------------------
 OK
(1 row)

SELECT nodeid = :clone_node_id AS first_clone, isactive, noderole, nodeisclone
FROM pg_dist_node WHERE nodeid IN (:clone_node_id, :other_clone_node_id) ORDER BY nodeid;
 first_clone | isactive | noderole | nodeisclone
---------------------------------------------------------------------
 t           | t        | primary  | f
 f           | t        | primary  | f
(2 rows)

-- of the writes after the initial load, the one in the transaction that
-- registered the clone and the one that was not blocked went through, and all
-- shards of the new table exist, also the ones that moved to the clone
SELECT count(*) FROM dist;
 count
---------------------------------------------------------------------
   102
(1 row)

SELECT count(*) FROM late;
 count
---------------------------------------------------------------------
     0
(1 row)

SELECT count(*) > 0 AS clone_got_shards
FROM pg_dist_shard_placement WHERE nodeport = :follower_worker_5_port AND shardid > 2147483647;
 clone_got_shards
---------------------------------------------------------------------
 t
(1 row)

-- recovery on the clone rolled back the prepared transaction of the primary,
-- as the primary would have
SELECT c AS orphaned_prepared_transactions
FROM dblink(:'worker_1_conn', format('SELECT count(*) FROM pg_prepared_xacts WHERE gid = %L', :'orphaned_gid')) AS t(c bigint);
 orphaned_prepared_transactions
---------------------------------------------------------------------
                              0
(1 row)

-- DDL works again and reaches the clone
CREATE SCHEMA promotion_concurrency_ddl;
SELECT c AS schema_on_clone
FROM dblink(:'clone_conn', $$SELECT count(*) FROM pg_namespace WHERE nspname = 'promotion_concurrency_ddl'$$) AS t(c bigint);
 schema_on_clone
---------------------------------------------------------------------
               1
(1 row)

-- cleanup
SELECT dblink_exec(:'primary_conn', 'DELETE FROM pg_catalog.pg_dist_cleanup WHERE operation_id = 8984000');
 dblink_exec
---------------------------------------------------------------------
 DELETE 1
(1 row)

SET client_min_messages TO WARNING;
DROP SCHEMA promotion_concurrency_ddl;
DROP SCHEMA promotion_concurrency CASCADE;
SELECT 1 FROM citus_remove_node('localhost', :master_port);
 ?column?
---------------------------------------------------------------------
        1
(1 row)

RESET client_min_messages;
RESET statement_timeout;
