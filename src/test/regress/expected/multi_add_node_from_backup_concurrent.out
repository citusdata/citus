-- wait until the promotion waits for the clone to catch up, with everything blocked
DO $$
BEGIN
    WHILE dblink_is_busy('promotion') = 1 AND NOT EXISTS (
        SELECT FROM dblink(current_setting('promotion_concurrency.clone_conn'),
                           $q$SELECT 1 FROM pg_stat_activity
                              WHERE query LIKE 'SELECT pg_last_wal_replay_lsn()%'
                                AND pid <> pg_backend_pid()$q$) AS t(found int)) LOOP
        PERFORM pg_sleep(0.01);
    END LOOP;
END $$;
SELECT min(g) AS late_key_on_primary
FROM generate_series(1, 2000) g
JOIN pg_dist_shard_placement p ON p.shardid = get_shard_id_for_distribution_column('late', g)
WHERE p.nodeport = :worker_5_port \gset
SELECT shardid AS late_shard_id, nodeport AS late_shard_port
FROM pg_dist_shard_placement JOIN pg_dist_shard USING (shardid)
WHERE logicalrelid = 'late'::regclass AND nodeport <> :worker_5_port
ORDER BY shardid LIMIT 1 \gset
SELECT CASE WHEN :late_shard_port = :worker_1_port THEN :worker_2_port ELSE :worker_1_port END AS late_target_port \gset
-- PG19 adds the lock that was waited for, with its OIDs, to the context of
-- lock timeout errors, so hide the context of the lock timeouts below
\set SHOW_CONTEXT never
-- writes to the primary's shards are blocked on all nodes, including the
-- shards of the new table, and of the table colocated with dist
SELECT dblink_exec(:'worker_1_conn', format('SET lock_timeout TO ''1s''; INSERT INTO promotion_concurrency.dist VALUES (%s)', :key_on_primary));
ERROR:  canceling statement due to lock timeout
SELECT dblink_exec(:'worker_1_conn', format('SET lock_timeout TO ''1s''; INSERT INTO promotion_concurrency.late VALUES (%s)', :late_key_on_primary));
ERROR:  canceling statement due to lock timeout
SELECT dblink_exec(:'worker_1_conn', format('SET lock_timeout TO ''1s''; INSERT INTO promotion_concurrency.dist_colocated VALUES (%s)', :key_on_primary));
ERROR:  canceling statement due to lock timeout
SET lock_timeout TO '1s';
INSERT INTO dist VALUES (:key_on_primary);
ERROR:  canceling statement due to lock timeout
INSERT INTO late VALUES (:late_key_on_primary);
ERROR:  canceling statement due to lock timeout
RESET lock_timeout;
-- other writes are not
SELECT dblink_exec(:'worker_1_conn', format('SET lock_timeout TO ''1s''; INSERT INTO promotion_concurrency.dist VALUES (%s)', :other_key_on_worker_1));
 dblink_exec
---------------------------------------------------------------------
 INSERT 0 1
(1 row)

-- distributed transactions that the primary starts cannot commit
SELECT dblink_exec(:'primary_conn', format('SET lock_timeout TO ''1s''; BEGIN; INSERT INTO promotion_concurrency.dist VALUES (%s), (%s); COMMIT', :key_on_worker_1, :key_on_worker_2));
ERROR:  canceling statement due to lock timeout
-- DDL is blocked on all nodes, and so are new shards
SELECT dblink_exec(:'worker_1_conn', 'SET lock_timeout TO ''1s''; CREATE SCHEMA promotion_concurrency_worker_ddl');
ERROR:  canceling statement due to lock timeout
SET lock_timeout TO '1s';
CREATE SCHEMA promotion_concurrency_coordinator_ddl;
ERROR:  canceling statement due to lock timeout
SELECT create_distributed_table('new_dist', 'id', colocate_with => 'none');
ERROR:  canceling statement due to lock timeout
-- shard moves, splits and rebalances that involve the primary are rejected,
-- whatever the colocation group
SELECT citus_move_shard_placement(:moved_shard_id, 'localhost', :moved_shard_port, 'localhost', :worker_5_port, 'block_writes');
ERROR:  could not acquire the shard transfer lock of node localhost:xxxxx to move shards
DETAIL:  It means that either a shard move, copy, split or rebalance involving the node, or the promotion of a clone of the node is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
SELECT citus_split_shard_by_split_points(:moved_shard_id, ARRAY['0'], ARRAY[:moved_node_id, :worker_5_node_id], 'block_writes');
ERROR:  could not acquire the shard transfer lock of node localhost:xxxxx to split shards
DETAIL:  It means that either a shard move, copy, split or rebalance involving the node, or the promotion of a clone of the node is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
SELECT create_distributed_table_concurrently('cdtc', 'id', colocate_with => 'none');
ERROR:  could not acquire the shard transfer lock of node localhost:xxxxx to split shards
DETAIL:  It means that either a shard move, copy, split or rebalance involving the node, or the promotion of a clone of the node is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
SELECT rebalance_table_shards('spread', threshold => 0.01, rebalance_strategy => 'by_shard_count', shard_transfer_mode => 'block_writes');
ERROR:  could not acquire the shard transfer lock of node localhost:xxxxx to move shards
DETAIL:  It means that either a shard move, copy, split or rebalance involving the node, or the promotion of a clone of the node is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
-- and so are the ones that change the colocation groups with shards on the
-- primary, including the group of the new table
SELECT rebalance_table_shards('dist', shard_transfer_mode => 'block_writes');
ERROR:  could not acquire the lock required to rebalance promotion_concurrency.dist
DETAIL:  It means that either a concurrent shard move or shard copy is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
SELECT citus_move_shard_placement(:late_shard_id, 'localhost', :late_shard_port, 'localhost', :late_target_port, 'block_writes');
ERROR:  could not acquire the lock required to move promotion_concurrency.late
DETAIL:  It means that either a concurrent shard move or colocated distributed table creation is happening.
HINT:  Make sure that the concurrent operation has finished and re-run the command
-- other shard moves are not rejected, they wait for the promotion like other
-- metadata changes
SELECT citus_move_shard_placement(:moved_shard_id, 'localhost', :moved_shard_port, 'localhost', :moved_target_port, 'block_writes');
ERROR:  canceling statement due to lock timeout
RESET lock_timeout;
\set SHOW_CONTEXT always
-- The clone gets its own group id only once transaction recovery on it ends,
-- since a run keeps the group id that it read first, the primary's. To keep
-- recovery on the clone running, leave a prepared transaction of the primary
-- on worker_1, which recovery rolls back since it has no commit record, and
-- make commits on worker_1 wait for a synchronous standby that does not exist.
SELECT groupid AS primary_group_id, format('citus_%s_1_1_0', groupid) AS orphaned_gid
FROM pg_dist_node WHERE nodeid = :worker_5_node_id \gset
SELECT set_config('promotion_concurrency.primary_group_id', :'primary_group_id', false) IS NOT NULL AS set;
 set
