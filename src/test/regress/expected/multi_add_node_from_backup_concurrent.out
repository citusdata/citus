-- the split plan contains all shards on the primary, with their ids intact
SELECT (SELECT array_agg(shardid ORDER BY shardid)
        FROM get_snapshot_based_node_split_plan('localhost', :worker_5_port, 'localhost', :follower_worker_5_port)) =
       (SELECT array_agg(shardid ORDER BY shardid)
        FROM pg_dist_shard_placement JOIN pg_dist_shard USING (shardid)
        WHERE logicalrelid = 'dist'::regclass AND nodeport = :worker_5_port) AS split_plan_has_all_shards;
 split_plan_has_all_shards
